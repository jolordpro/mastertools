{
  "description": "Renders the always-on and model-routing rules from the user's profile at every session start, one part per command so no output passes Claude Code's 10,000-character hook cap; restores the project checkpoint after compaction; prints an open sequence build's checkpoint in its folder; warns when compaction is close; postpones automatic compaction while a multi-step operation is mid-way.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/render_rules.py\" \"${CLAUDE_PLUGIN_ROOT}/rules/ALWAYS-ON.md\" --part 1 --profile \"${CLAUDE_PLUGIN_OPTION_PROFILE:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/profile.md}\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/render_rules.py\" \"${CLAUDE_PLUGIN_ROOT}/rules/ALWAYS-ON.md\" --part 2 --profile \"${CLAUDE_PLUGIN_OPTION_PROFILE:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/profile.md}\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/render_rules.py\" \"${CLAUDE_PLUGIN_ROOT}/rules/ALWAYS-ON.md\" --part 3 --profile \"${CLAUDE_PLUGIN_OPTION_PROFILE:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/profile.md}\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/render_rules.py\" \"${CLAUDE_PLUGIN_ROOT}/rules/MODEL-ROUTING.md\" --part 1 --profile \"${CLAUDE_PLUGIN_OPTION_PROFILE:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/profile.md}\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/render_rules.py\" \"${CLAUDE_PLUGIN_ROOT}/rules/MODEL-ROUTING.md\" --part 2 --profile \"${CLAUDE_PLUGIN_OPTION_PROFILE:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/profile.md}\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/render_rules.py\" \"${CLAUDE_PLUGIN_ROOT}/rules/MODEL-ROUTING.md\" --part 3 --profile \"${CLAUDE_PLUGIN_OPTION_PROFILE:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/profile.md}\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/context-watch.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/compact-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
